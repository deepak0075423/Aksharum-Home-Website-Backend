# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aksharum?schema=public"
# Secret used to sign admin JWTs — set a long random string in production
JWT_SECRET="change-me"
# API port
PORT=4000
# Allowed browser origin for CORS (the frontend URL)
CORS_ORIGIN="http://localhost:3000"
# Initial admin credentials (used only by the seed script; change after first login)
ADMIN_EMAIL="admin@aksharum.in"
ADMIN_PASSWORD="Aksharum@2026"
