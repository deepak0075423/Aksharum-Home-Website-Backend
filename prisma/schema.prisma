generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  // The seeded primary admin: the only account allowed to deactivate or
  // delete other admins, and the one account that can never be removed.
  isRoot       Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A full public page: the original markup lives in bodyHtml so the design
// stays byte-for-byte identical; admins edit it from the panel.
model Page {
  id         String   @id @default(cuid())
  slug       String   @unique // "home", "about", "career", ...
  title      String
  bodyHtml   String   // page content only — shared header/footer are composed in
  cssLinks   String[] // local stylesheet hrefs, e.g. /css/career.css
  fontLinks  String[] // external font/preconnect hrefs
  scripts    String[] // ordered script srcs (CDN + local page js)
  showLayout Boolean  @default(true) // wrap with the shared header/footer
  navStyle   String   @default("") // original per-page inline style on <nav>

  // Per-page SEO
  metaDescription String @default("")
  metaKeywords    String @default("")
  ogImage         String @default("") // social-share preview image URL

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum JobStatus {
  OPEN
  FILLED
  CLOSED
}

model Job {
  id           String           @id @default(cuid())
  title        String
  department   String
  location     String
  type         String           @default("Full-time")
  description  String           @default("")
  status       JobStatus        @default(OPEN)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id       String     @id @default(cuid())
  slug     String     @unique // url segment: /blogs/<slug>
  title    String
  excerpt  String     @default("") // listing-card summary; also the meta description fallback
  bodyHtml String     @default("") // rich-text editor output
  status   BlogStatus @default(DRAFT)

  // Cover image is optional by design — the listing card falls back to a
  // brand gradient tile so every card keeps the same height.
  coverPath String @default("") // filename in uploads/, served via /api/blogs/cover/:file
  coverAlt  String @default("")

  author String   @default("Aksharum")
  tags   String[]

  // Set the first time the post is published, then left alone so the
  // public date doesn't jump on every later edit.
  publishedAt DateTime?

  // Per-post SEO — same shape as Page, so the frontend can reuse its helpers
  metaDescription String @default("")
  metaKeywords    String @default("")
  ogImage         String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

model JobApplication {
  id         String            @id @default(cuid())
  fullName   String
  email      String
  role       String
  experience String
  company    String            @default("")
  portfolio  String            @default("")
  locations  String[]
  message    String
  resumePath String?
  resumeName String?
  status     ApplicationStatus @default(NEW)
  job        Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId      String?
  createdAt  DateTime          @default(now())
}

enum InboxStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactSubmission {
  id             String      @id @default(cuid())
  name           String
  email          String
  school         String
  phone          String      @default("")
  role           String      @default("")
  students       String      @default("")
  moduleInterest String      @default("")
  message        String
  status         InboxStatus @default(NEW)
  createdAt      DateTime    @default(now())
}

enum DemoStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

model DemoRequest {
  id            String     @id @default(cuid())
  name          String
  phone         String
  email         String
  school        String
  role          String     @default("")
  students      String     @default("")
  modules       String[]
  notes         String     @default("")
  preferredDate String     @default("")
  preferredSlot String     @default("")
  status        DemoStatus @default(NEW)
  createdAt     DateTime   @default(now())
}

// Free-form settings store: "smtp" and "site" keys are used today,
// more can be added without a migration.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
